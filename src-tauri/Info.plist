<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Merged into the macOS app bundle by Tauri. Linux builds ignore it. -->
<plist version="1.0">
<dict>
	<!-- Video plays through the app's own loopback proxy (http://127.0.0.1); App Transport
	     Security needs this to allow plain HTTP to the local machine. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
